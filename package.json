{
  "name": "crypto-analyst-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Risk-gated daily trading system with direct exchange execution",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:repository-safety": "node scripts/check-repository-safety.mjs",
    "review:target": "node --import tsx scripts/review-target.ts",
    "credentials:setup:testnet": "node --import tsx scripts/credentials.ts setup testnet",
    "credentials:setup:mainnet": "node --import tsx scripts/credentials.ts setup mainnet",
    "credentials:setup:demo": "node --import tsx scripts/credentials.ts setup demo",
    "credentials:remove:testnet": "node --import tsx scripts/credentials.ts remove testnet",
    "credentials:remove:mainnet": "node --import tsx scripts/credentials.ts remove mainnet",
    "credentials:remove:demo": "node --import tsx scripts/credentials.ts remove demo",
    "credentials:connect:testnet": "node --import tsx scripts/credentials-connect.ts testnet",
    "credentials:connect:mainnet": "node --import tsx scripts/credentials-connect.ts mainnet",
    "test:testnet": "node --import tsx scripts/testnet-smoke.ts",
    "test:bybit:public": "TRADER_ENV=public-mainnet node --import tsx scripts/public-market-smoke.ts",
    "coinalyze:liquidation:smoke": "node --import tsx scripts/coinalyze-liquidation-smoke.ts",
    "probe:bybit:testnet": "node --import tsx scripts/bybit-capability-probe.ts --environment testnet",
    "probe:bybit:demo": "node --import tsx scripts/bybit-capability-probe.ts --environment demo",
    "probe:bybit:recover": "node --import tsx scripts/bybit-capability-probe.ts --manual-recover",
    "probe:bybit:testnet:recover": "node --import tsx scripts/bybit-capability-probe.ts --manual-recover --environment testnet",
    "verify:bybit:demo-adapter": "node --import tsx scripts/bybit-demo-adapter-verification.ts",
    "trader:demo": "node --import tsx src/cli/trader-demo.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:release": "npm run typecheck && npm run lint && npm run format:check && npm run check:repository-safety && npm test"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "big.js": "^7.0.1"
  }
}
